<Project>
    <PropertyGroup>
        <!-- Megadot current version is 4.5.1, and the game won't load your .pck if the Godot version used is newer. -->
        <!-- MegaDot / Godot 4.5.1 mono executable used for export-pack when publishing -->
        <GodotPath>/home/adsfgh01/megadot/MegaDot_v4.5.1-stable_mono_linux.x86_64</GodotPath>

        <!-- If sts2 is not found automatically, uncomment the following and set it manually -->
        <Sts2Path>/mnt/g/SteamLibrary/steamapps/common/Slay the Spire 2</Sts2Path>
        <!-- The game install is the Windows build, so its data folder is not the linuxbsd one. -->
        <Sts2DataDir>$(Sts2Path)/data_sts2_windows_x86_64</Sts2DataDir>
    </PropertyGroup>
</Project>
